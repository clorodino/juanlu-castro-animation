---
import PostImage from "../../components/PostImage.astro";
import Layout from "../../layouts/Layout.astro";
import Grid from "../../components/Grid.astro";
import Paragraphs from "../../components/Paragraphs.astro";
import BackButton from "../../components/BackButton.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import H3 from "../../components/H3.astro";
const title = "Graf 2019";
const videoUrl = "034310ce-cedd-451d-bb6f-f0d5fef72850";
---

<Layout>
  <BackButton/>
  <div
    class="flex flex-col items-start gap-4 w-full"
  >
      <iframe
        class="w-fit aspect-video"
        src=`https://framerate.tv/embed/${videoUrl}?muted=1&primary_color=%2523cffafe&track_color=%2523ffffff&theme=minimal`
        allow="autoplay; fullscreen; picture-in-picture" 
        allowfullscreen
        title={title}
        >
      </iframe>

    <!-- TITULO -->
    <H1>
      Graf 2019
    </H1>
    <!--  -->

    <Paragraphs>
      <div class="px-8 pb-4 md:pb-12">
      <p>
        In GRAF 2019 Barcelona edition, we made an animated version of the
        poster campaign designed by Lorenzo Montatore which was shown on screens
        inside the event, and also in social media profiles.
      </p>
      </div>

      <!-- Rough Animation -->
      <div class="bg-cyan-100  mt-8 pb-12 w-full">
        <H2>
          Design
        </H2>
     
      <Grid grid={1}>
        <PostImage
          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743176401/juanlu-castro-animation/graf-2019/videos/cartel-graf-2019_jpf57t.png"
          title=""
          style="flex justify-center items-center"
          className="max-w-screen-sm"
        />
      </Grid>

      <!-- Clean Animation -->
      <H2>
        Clean Animation
      </H2>
      <Grid grid={1}>
        <video
          class="rounded-xl"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743175997/juanlu-castro-animation/graf-2019/videos/logo_ooinna.mp4"
        ></video>
      </Grid>
      <Grid grid={3}>
        <video
          class="rounded-full"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743174562/juanlu-castro-animation/graf-2019/videos/Personaje_01_Behance_msio9j.mp4"
        ></video>
        <video
          class="rounded-full"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743175998/juanlu-castro-animation/graf-2019/videos/character-02_jrxoyt.mp4"
        ></video>
        <video
          class="rounded-full"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743175999/juanlu-castro-animation/graf-2019/videos/character-03_tw8tt5.mp4"
        ></video>
        <video
          class="rounded-full"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743176000/juanlu-castro-animation/graf-2019/videos/character-04_tmhfio.mp4"
        ></video>
        <video
          class="rounded-full"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743176001/juanlu-castro-animation/graf-2019/videos/character-05_bndcyz.mp4"
        ></video>
        <video
          class="rounded-full"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743176002/juanlu-castro-animation/graf-2019/videos/character-06_bkifjq.mp4"
        ></video>
      </Grid>
      <Grid grid={2}>
        <video
          class="rounded-full"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743176004/juanlu-castro-animation/graf-2019/videos/character-07_lvio4a.mp4"
        ></video>
        <video
          class="rounded-full"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743176003/juanlu-castro-animation/graf-2019/videos/character-08_kora37.mp4"
        ></video>
      </Grid>
      
      </div>

      <!-- Credits -->
      <div
        class="w-full px-8 flex flex-col justify-center items-start py-12  gap-4"
      >
        <Paragraphs>
          <H3>Direction & animation:</H3>
          <p>Juanlu Castro</p>
        </Paragraphs>
        <Paragraphs>
          <H3>Illustration:</H3>
          <p>Lorenzo Montatore</p>
        </Paragraphs>

      </div>
    </Paragraphs>
  </div>
</Layout>
