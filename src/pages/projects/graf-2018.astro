---
import PostImage from "../../components/PostImage.astro";
import Layout from "../../layouts/Layout.astro";
import Grid from "../../components/Grid.astro";
import Paragraphs from "../../components/Paragraphs.astro";
import BackButton from "../../components/BackButton.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import H3 from "../../components/H3.astro";

const title = "Graf 2018";
const videoUrl = "";
---

<Layout>
  <BackButton/>
  <div
    class="flex flex-col items-start gap-4 w-full"
  >
      <video
        class="w-full aspect-video"
        loop
        src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1737721262/juanlu-castro-animation/graf-2018/graf-2018_e6fuza.mp4"
        autoplay>
      </video>

    <!-- TITULO -->
    <H1>
      Graf 2018
    </H1>
    <!--  -->

    <Paragraphs>
      <div class="px-8 pb-4 md:pb-12">
      <p>
        GRAF is a small press and independent edition festival, where small and
        medium editors, self-edition collectives, graphic artists and fanzines
        have a place. It takes place since 2013, alternately in Madrid and
        Barcelona.
      </p>
      <p>
        I made these four animations promoting the application period for
        editors, artists, collectives or cartoonist who are interested in join
        to next edition.
      </p>
      </div>

      <!-- Rough Animation -->
      <div class="bg-cyan-100  mt-8 pb-12 w-full">
        <H2>
          Rough Animation
        </H2>
     
      <Grid grid={1}>
        <video
          class="w-full "
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743087021/juanlu-castro-animation/graf-2018/graf-2018-rough_wm5py9.mp4"
          autoplay></video>
      </Grid>

      <!-- Clean Animation -->
      <H2>
        Clean Animation
      </H2>
      <Grid grid={2}>
        <video
          class="w-full aspect-square max-w-screen-lg"
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1737721260/juanlu-castro-animation/graf-2018/G_ndpgdq.mp4"
          autoplay></video>
        <video
          class="w-full aspect-square max-w-screen-lg"
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1737721260/juanlu-castro-animation/graf-2018/R_tnh87i.mp4"
          autoplay></video>
        <video
          class="w-full aspect-square max-w-screen-lg"
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1737721260/juanlu-castro-animation/graf-2018/A_bxnl1r.mp4"
          autoplay></video>
        <video
          class="w-full aspect-square max-w-screen-lg"
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1737721265/juanlu-castro-animation/graf-2018/F_vh9rkd.mp4"
          autoplay></video>
      </Grid>
      
      </div>

      <!-- Credits -->
      <div
        class="w-full px-8 flex flex-col justify-center items-start py-12  gap-4"
      >
        <Paragraphs>
          <H3>
            Direction, design & animation:
          </H3>
          <p>Juanlu Castro</p>
        </Paragraphs>

      </div>
    </Paragraphs>
  </div>
</Layout>
