---
import PostImage from "../../components/PostImage.astro";
import Layout from "../../layouts/Layout.astro";
import Grid from "../../components/Grid.astro";
import Paragraphs from "../../components/Paragraphs.astro";
import BackButton from "../../components/BackButton.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import H3 from "../../components/H3.astro";
---

<Layout>
  <BackButton/>
  <div
    class="flex flex-col items-start gap-4 w-full"
  >
    <!-- Video -->
    <iframe
      class="w-fit
      aspect-video"
      src="https://www.youtube.com/embed/Zh9DZQlSKe8?si=aP1amTZ6GWV4dTXj&controls=0"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
      title="Wallapop FAQ"
      >
    </iframe>

    <!-- TITULO -->
    <H1>
      Wallapop FAQ
    </H1>
    <!--  -->

    <!-- <iframe
      class="w-fit
      aspect-video"
      src="https://www.youtube.com/embed/yBCN_zf0GEc?si=oQB551ENi_tG4_ky&controls=0"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
      title="Wallapop FAQ"
      >
    </iframe>
    <iframe
      class="w-fit
      aspect-video"
      src="https://www.youtube.com/embed/86C14X0xIls?si=1QggXXyscuGzqErN&controls=0"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
      title="Wallapop FAQ"
      >
    </iframe> -->


    <Paragraphs>
      <div class="px-8 pb-4 md:pb-12">
      <p>
        Wallapop wanted to make a series of videos to explain the frequently
        asked questions based on some characters they had designed.
      </p>
      <p>
        You can watch the full list of videos on the <a
          class="underline"
          href="https://www.youtube.com/playlist?list=PLJwag2DmJfeQzo5eIY1b6rqq3ItarSCiL"
          target="_blank">Wallapop YouTube channel</a
        >.
      </div>

      <!-- Rough Animation -->
      <div class="bg-cyan-100  mt-8 pb-12 w-full">
        <H2>
          Design
        </H2>
     
      <Grid grid={2}>
        <PostImage

          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743413025/juanlu-castro-animation/wallapop/wallapop-01_rahw8j.png"
          title=""
        />
        <PostImage
          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743413025/juanlu-castro-animation/wallapop/wallapop-02_gm1dcc.png"
          title=""
        />
        <PostImage
          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743413027/juanlu-castro-animation/wallapop/wallapop-03_unl3vf.png"
          title=""
        />
        <PostImage
          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743413024/juanlu-castro-animation/wallapop/wallapop-04_lkn2st.png"
          title=""
        />
        <PostImage
          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743413028/juanlu-castro-animation/wallapop/wallapop-05_rtxksq.png"
          title=""
        />
        <PostImage
          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743413026/juanlu-castro-animation/wallapop/wallapop-07_fbgape.png"
          title=""
        />
        <PostImage
          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743413029/juanlu-castro-animation/wallapop/wallapop-08_rfazh3.png"
          title=""
        />
        <PostImage
          src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743413027/juanlu-castro-animation/wallapop/wallapop-06_m1qcqd.png"
          title=""
        />
      </Grid>
      
      </div>

      <!-- Credits -->
      <div
        class="w-full px-8 flex flex-col justify-center items-start py-12  gap-4"
      >
        <Paragraphs>
          <H3>Direction:</H3>
          <p>Tres Studio</p>
        </Paragraphs>
        <Paragraphs>
          <H3>Story:</H3>
          <p>Pietro Zoli</p>
        </Paragraphs>
        <Paragraphs>
          <H3>Illustration:</H3>
          <p>Ivan Mesaroš</p>
        </Paragraphs>
        <Paragraphs>
          <H3>Animation:</H3>
          <p>Juanlu Castro</p>
        </Paragraphs>

      </div>
    </Paragraphs>
  </div>
</Layout>
