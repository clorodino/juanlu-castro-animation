---
import PostImage from "../../components/PostImage.astro";
import Layout from "../../layouts/Layout.astro";
import Grid from "../../components/Grid.astro";
import Paragraphs from "../../components/Paragraphs.astro";
import BackButton from "../../components/BackButton.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import H3 from "../../components/H3.astro";
const title = "Hoops";
const videoUrl = "";
---

<Layout>
  <BackButton/>
  <div
    class="flex flex-col items-start gap-4 w-full"
  >
      <iframe
        class="w-full
          aspect-video"
        src="https://www.youtube.com/embed/RLf-z6WySDA?si=6Ua5mMrU_n6LcX6s"
        title="hoops trailer"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      >
      </iframe>

    <!-- TITULO -->
    <H1>
      Hoops
    </H1>
    <!--  -->

    <Paragraphs>
      <div class="px-8 pb-4 md:pb-12">
      <p>
        Hoops is a comic by Genie Espinosa, a dystopian, feminist and
        post-millenial in which three close friends are trapped between two
        parallel universes and must find a way to reunite.
      </p>
      <p>
        I made a book trailer directed by Genie and inspired on the amazing
        comic look.
      </p>
      </div>

      <!-- Rough Animation -->
      <div class="bg-cyan-100  mt-8 pb-12 w-full">
        <H2>
          Clean and Color Animation
        </H2>
     

      <Grid grid={2}>
        <video
          class="w-full max-w-screen-sm"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743410818/juanlu-castro-animation/hoops/ghost-line_cbewld.mp4"
        ></video>
        <video
          class=" w-full max-w-screen-sm"
          autoplay
          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743410817/juanlu-castro-animation/hoops/ghost-color_s7n3kj.mp4"
        ></video>
      </Grid>
      </div>
      </div>

      <!-- Credits -->
      <div
        class="w-full px-8 flex flex-col justify-center items-start py-12  gap-4"
      >
        <Paragraphs>
          <H3>
            Direction & Illustration:
          </H3>
          <p>Genie Espinosa</p>
        </Paragraphs>
        <Paragraphs>
          <H3>Animation:</H3>
          <p>Juanlu Castro</p>
        </Paragraphs>
       
      </div>
    </Paragraphs>
  </div>
</Layout>
