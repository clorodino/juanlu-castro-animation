---
import PostImage from "../../components/PostImage.astro";
import Layout from "../../layouts/Layout.astro";
import Grid from "../../components/Grid.astro";
import Paragraphs from "../../components/Paragraphs.astro";
import BackButton from "../../components/BackButton.astro";
import H1 from "../../components/H1.astro";
import H2 from "../../components/H2.astro";
import H3 from "../../components/H3.astro";
const title = "Weird Walk";
const videoUrl = "9ee3dc80-7dad-4bdc-a66a-b1a568cbfc1d";
---

<Layout>
  <BackButton/>
  <div
    class="flex flex-col items-start gap-4 w-full"
  >
      <iframe
        class="w-fit aspect-video"
        src=`https://framerate.tv/embed/${videoUrl}?muted=1&primary_color=%2523cffafe&track_color=%2523ffffff&theme=minimal`
        allow="autoplay; fullscreen; picture-in-picture" 
        allowfullscreen
        title={title}
        >
      </iframe>

    <!-- TITULO -->
    <H1>
      Weird Walk
    </H1>
    <!--  -->

    <Paragraphs>
      <div class="px-8 pb-4 md:pb-12">
      <p>
        Weird Walk is a piece made from several loops posted on Instagram. The
        main intention was to make an "exquisite corpse", posting a clip based
        on the previous every two days.
      </p>
      <p>
        Finally, I made the entire composition with all the clips, creating a
        big loop.
      </p>
      </div>

      <!-- Rough Animation -->
      <div class="bg-cyan-100  mt-8 pb-12 w-full">
        <H2>
          Clean Animation
        </H2>
     
<Grid grid={1}>
        <video

          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743164329/juanlu-castro-animation/weird-walk/clean/01_oh7j4l.mp4"
          autoplay></video>
        <video

          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743164331/juanlu-castro-animation/weird-walk/clean/02_fc4kot.mp4"
          autoplay></video>
        <video

          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743164330/juanlu-castro-animation/weird-walk/clean/03_xhpnsi.mp4"
          autoplay></video>
        <video

          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743164332/juanlu-castro-animation/weird-walk/clean/04_ytemqj.mp4"
          autoplay></video>
      </Grid>

      <!-- Color Animation -->
      <H2>
        Color Animation
      </H2>
      <Grid grid={1}>
        <video

          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743164329/juanlu-castro-animation/weird-walk/color/01_vgyzqa.mp4"
          autoplay></video>
        <video

          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743164330/juanlu-castro-animation/weird-walk/color/02_wgiqdl.mp4"
          autoplay></video>
        <video

          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743164328/juanlu-castro-animation/weird-walk/color/03_dv0geu.mp4"
          autoplay></video>
        <video

          loop
          src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1743164328/juanlu-castro-animation/weird-walk/color/04_hc0j0s.mp4"
          autoplay></video>
      </Grid>
      
      </div>

      <!-- Credits -->
      <div
        class="w-full px-8 flex flex-col justify-center items-start py-12  gap-4"
      >
        <Paragraphs>
          <H3> Direction, design, animation & sound:</H3>
          <p>Juanlu Castro</p>
        </Paragraphs>
       

      </div>
    </Paragraphs>
  </div>
</Layout>
