---
import Paragraphs from "../components/Paragraphs.astro";
import Layout from "../layouts/Layout.astro";
import H1 from "../components/H1.astro";
---

<Layout>
  <div class="pb-12 px-8 w-full flex-col md:flex-row gap-12 md:mt-20 mt-8 grid grid-cols-1 md:grid-cols-2 ">
    <!-- Texto -->
    <div
      class="flex flex-col items-start gap-4 w-full max-w"
    >
      <H1 class="px-0 !pt-0 !md:pt-0 ">
        Hello!
      </H1>
      <Paragraphs>
        <div class="pb-4 md:pb-12">
          <p>
            I'm Juanlu Castro, 2d animator, illustrator and motion designer
            based in Barcelona.
          </p>
          <p>
            With more than 10 years of experience in the animation, I've created
            pieces for international clients like Ogilvy, Tous or Wallapop.
          </p>
          <p>
          My work is clearly influenced by frame-by-frame character animation. I also love comics, and I'm part of the Graf staff, for which I made several pieces throw the years.
          </p>
          <p>
            Contact: <a class="text-cyan-100 hover:text-cyan-500 font-zalando font-semibold text-lg md:text-xl" href="mailto:juanluiscas@gmail.com"
              >juanluiscas@gmail.com</a
            >
          </p>
        </div>
      </Paragraphs>
    </div>
    <!-- Imagen -->
    <div>
      <img
        class="overflow-hidden  object-center object-cover md:min-w-80 w-full aspect-square"
        src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1743415347/juanlu-castro-animation/img-port/profile_p4mkiy.png"
        alt="Juanlu Castro"
      />
    </div>
  </div>



