---
import Paragraphs from "../components/Paragraphs.astro";
import Layout from "../layouts/Layout.astro";
import H1 from "../components/H1.astro";
---

<Layout>
  <div class="pb-12 px-8 w-full flex-col md:flex-row gap-12 md:mt-20 mt-8 grid grid-cols-1 md:grid-cols-2 ">
    <!-- Texto -->
    <div
      class="flex flex-col items-start gap-4 w-full max-w"
    >
      <H1 class="!px-0 !pt-0 !md:pt-0 ">
        Hello!
      </H1>
      <Paragraphs>
        <div class="pb-4 md:pb-12">
          <p>I'm Juanlu Castro, 2D animator and motion designer based in Barcelona.</p>
          <p>I love frame-by-frame animation and comics, an influence that is clearly visible in my work.</p>
          <p>I have been animating and creating pieces for a handful of international clients for over 15 years.</p>
          <p>Also, I have been part of the <a class=" hover:text-cyan-500 text-lg md:text-xl" href="https://www.grafcomic.com/" target="_blank">Graf Cómic</a> staff since 2016, and I made a lot of pieces for them over the years.</p>
          <p>
            Contact: <a class="text-cyan-100 hover:text-cyan-500 font-zalando font-semibold text-lg md:text-xl" href="mailto:juanluiscas@gmail.com"
              >juanluiscas@gmail.com</a
            >
          </p>
        </div>
      </Paragraphs>
    </div>
    <!-- Imagen -->
    <div>
      <img
        class="overflow-hidden  object-center object-cover md:min-w-80 w-full aspect-square"
        src="https://res.cloudinary.com/dtgwzogvc/image/upload/v1786544274/juanlu-castro-animation/img-port/profile_zbhxbw.webp"
        alt="Juanlu Castro"
      />
    </div>
  </div>
</Layout>
