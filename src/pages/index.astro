---
import Projects from "../components/Projects.astro";
import Layout from "../layouts/Layout.astro";
import VideoModal from '../components/VideoModal.astro';
import BackToTop from "../components/BackToTop.astro";
---

<Layout>
  <div class="relative w-screen h-[66.66dvh] overflow-hidden bg-black -mt-24  md:h-screen md:-mt-[7rem] z-10">
    <video 
      class="absolute top-0 left-0 w-full h-full object-cover pointer-events-none" 
      autoplay 
      loop 
      muted 
      playsinline>
      <source src="https://res.cloudinary.com/dtgwzogvc/video/upload/v1785338131/juanlu-castro-animation/demo_rkvqch.mp4" type="video/mp4">
      Tu navegador no soporta videos HTML5.
    </video>
      <VideoModal 
        class="px-5 py-3 text-sm font-zalando font-semibold text-zinc-100 bg-cyan-500/60 rounded-full hover:bg-cyan-500 hover:text-cyan-100 transition-colors relative z-20 top-full left-full -translate-x-full -translate-y-full -mx-4 -my-7 flex items-center gap-1 md:px-3 md:py-2 md:text-base"
        buttonText="View Reel" 
        videoUrl="https://framerate.tv/watch/d542eaa4-f06d-42c9-9fe4-66ec6d748cf9"
        />

  </div>
  <Projects />
    <BackToTop>
</Layout>


