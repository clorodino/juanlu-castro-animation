---

import NavLink from "./NavLink.astro";
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
export const baseUrl = "";
---

<nav class=" w-full sticky top-0 z-50 " id="navbar">
<!-- <nav class=" w-full relative z-50 " id="navbar"> -->
  <div
    class="flex flex-wrap items-center justify-between mx-auto py-6 relative z-60 px-8"
  >
    <a href=`${baseUrl}/` >
      <LottieAnimation
        class="w-16 h-16" 
        src="https://res.cloudinary.com/dtgwzogvc/raw/upload/v1786618519/juanlu-castro-animation/logo_osqjo5.json" 
        autoplay="visible" 
      />
    </a>
<!--  -->

    <button 
      class="group w-12 h-12 text-cyan-100 text-center items-center justify-center,inset_0_-2px_0_theme(colors.slate.950/.04)] ,0_4px_8px_theme(colors.slate.950/.12),inset_0_-2px_0_theme(colors.slate.950/.04)] transition z-20 md:hidden inline-flex" 

      aria-pressed="false" 
      onclick="this.setAttribute('aria-pressed', !(this.getAttribute('aria-pressed') === 'true'))"

      data-collapse-toggle="navbar-default"
      type="button"
      class="inline-flex items-center p-2 w-14 h-14 justify-center text-sm text-cyan-100 rounded-xl md:hidden focus:outline-none focus:ring-0 dark:text-cyan-100"
      aria-controls="navbar-default"
      aria-expanded="false"
      id="burger-button"
      >
      <span class="sr-only">Menu</span>
      <svg aria-hidden="true" class="w-9 h-9 fill-current pointer-events-none" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
          <rect class="origin-center -translate-y-[5px] translate-x-[7px] transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.1)] group-[[aria-pressed=true]]:translate-x-0 group-[[aria-pressed=true]]:translate-y-0 group-[[aria-pressed=true]]:rotate-[315deg]" y="7" width="9" height="2" rx="0"></rect>
          <rect class="origin-center transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.8)] group-[[aria-pressed=true]]:rotate-45" y="7" width="16" height="2" rx="0"></rect>
          <rect class="origin-center translate-y-[5px] transition-all duration-300 ease-[cubic-bezier(.5,.85,.25,1.1)] group-[[aria-pressed=true]]:translate-y-0 group-[[aria-pressed=true]]:-rotate-[225deg]" y="7" width="9" height="2" rx="0"></rect>
      </svg>
    </button>

<!--  -->

    <div
      id="nav-container"
      class="md:translate-y-0 md:h-8 md:relative md:block md:w-auto md:top-0 w-full overflow-hidden h-dvh absolute top-0 left-0 hidden"
    >
      <div
        class="w-full transition-transform duration-300 ease-in-out md:block md:w-auto h-screen md:h-8 md:relative absolute top-0 z-60 md:translate-y-0 -translate-y-full left-0 flex justify-center items-center bg-zinc-900 md:bg-transparent"
        id="navbar-default"
      >
        <ul
          class="flex gap-8 items-center text-2xl tracking-wider md:flex-row flex-col md:pt-0 pt-10 text-slate-50"
        >
          <NavLink link=`${baseUrl}/about` title="About" />
          <NavLink link=`${baseUrl}/` title="Work" />
          <!-- <ToggleTheme /> -->
        </ul>
      </div>
    </div>
  </div>
</nav>

<script defer>
  let isCollapsed = true;
  const handleCollapse = () => {
    console.log("clicked");
    if (isCollapsed) {
      document.querySelector("#nav-container").classList.remove("hidden");
      setTimeout(() => {
        document
          .querySelector("#navbar-default")
          .classList.remove("-translate-y-full");
        document
          .querySelector("#navbar-default")
          .classList.add("translate-y-0");
        document.body.classList.add("overflow-y-hidden");
        isCollapsed = !isCollapsed;
      }, 50);
    } else if (!isCollapsed) {
      document
        .querySelector("#navbar-default")
        .classList.remove("translate-y-0");
      document
        .querySelector("#navbar-default")
        .classList.add("-translate-y-full");
      isCollapsed = !isCollapsed;
      setTimeout(() => {
        document.querySelector("#nav-container").classList.add("hidden");
      }, 300);
      document.body.classList.remove("overflow-y-hidden");
    }
  };
  const button = document.querySelector("#burger-button");

  button?.addEventListener("click", () => handleCollapse());
</script>
