---
interface Props {
  url: string;
  image: string;
  title: string;
}
const { url, image, title } = Astro.props;
---

<div class="rounded-lg overflow-hidden">
  <a class="relative flex justify-center" href={url}>
    <p
      class="w-full h-full hover:transition-all hover:bg-zinc-900/70 absolute flex justify-center items-center text-cyan-100 font-zalando font-normal text-opacity-0  hover:text-opacity-100 text-[20px] hover:text-2xl ease-in-out delay-75 duration-500 hover:backdrop-blur-sm tracking-wider px-4 text-center"
    >
      <span>
        {title}
      </span>
    </p>

    <img class="h-auto max-w-full p-4" src={image} alt="" />
  </a>
</div>
