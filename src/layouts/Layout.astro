---
import "@fontsource-variable/host-grotesk";
import '@fontsource-variable/zalando-sans-expanded/wght.css';
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
// import "../styles/global.css";
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="dark !scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href=`${baseUrl}/favicon.ico` />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Freelance Motion Designer, Animator and Illustrator based in Barcelona. Experienced in Animations, TV, Social Media, Events or Explainer Videos.">
    <title>Juanlu Castro - Animation</title>
    <!-- Google tag (gtag.js) -->
    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-VJLYNCCGJZ"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      
      gtag('config', 'G-VJLYNCCGJZ');
      </script>
    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>

  <body class="bg-zinc-900 text-zinc-100 overflow-x-hidden">
    <div
      class=" items-center min-h-screen flex flex-col justify-between w-full"
    >
      <Navbar />
      <slot />
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
  }
  html {
    font-family: "host-grotesk", sans-serif;
    scroll-behavior: smooth !important;
  }
  body {
    background-color: #18181b;
    display: flex;
    justify-content: center;
    color: #f4f4f5;
  }
  p {
    margin-bottom: 0.75rem;
  }

</style>
